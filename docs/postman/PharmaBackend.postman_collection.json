{
  "info": {
    "_postman_id": "a9cc69e3-13fd-4e4e-bad4-5f7937b85f14",
    "name": "PharmaBackend · S14 estabilización",
    "description": "Casos representativos de autenticación, productos, ventas y auditoría. Ejecutar únicamente contra desarrollo local: el caso 201 crea un cliente y una venta real, y modifica stock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "adminPassword", "value": "" },
    { "key": "vendedorPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "vendedorToken", "value": "" },
    { "key": "demoClienteId", "value": "" },
    { "key": "demoProductoId", "value": "" },
    { "key": "demoCategoriaId", "value": "" },
    { "key": "demoDni", "value": "" },
    { "key": "demoEmail", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Admin · iniciar sesión",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login admin responde 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Vendedor · iniciar sesión",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"vendedor\",\n  \"password\": \"{{vendedorPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login vendedor responde 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('vendedorToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Credenciales inválidas · 401",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"usuario-inexistente\",\n  \"password\": \"incorrecta\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Credenciales inválidas responden 401', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    },
    {
      "name": "Productos y clientes",
      "item": [
        {
          "name": "Listar productos paginados · 200 y preparar producto de prueba",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/productos?pagina=0&tamanio=20&ordenarPor=nombre&direccion=asc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Listado de productos responde 200', () => pm.response.to.have.status(200));", "const p = pm.response.json().contenido.find(x => x.estado && x.stock > 0);", "if (p) { pm.collectionVariables.set('demoProductoId', p.id); pm.collectionVariables.set('demoCategoriaId', p.categoriaId); }", "pm.test('Hay un producto activo con stock para las pruebas', () => pm.expect(p).to.be.ok);"] } }]
        },
        {
          "name": "Tamaño de página fuera del máximo · 409",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/productos?pagina=0&tamanio=500&ordenarPor=nombre&direccion=asc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('El tamaño 500 responde 409', () => pm.response.to.have.status(409));", "pm.test('Se informa el límite de 100', () => pm.expect(pm.response.json().message).to.include('100'));"] } }]
        },
        {
          "name": "Producto inexistente · 404",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/productos/999999999" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Producto inexistente responde 404', () => pm.response.to.have.status(404));"] } }]
        },
        {
          "name": "Crear cliente temporal · 201 (prepara datos para la venta)",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const id = String(Date.now()).slice(-8);", "pm.collectionVariables.set('demoDni', id);", "pm.collectionVariables.set('demoEmail', `s14.${id}@example.test`);"] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Alta de cliente responde 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('demoClienteId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"dni\": \"{{demoDni}}\",\n  \"nombres\": \"Cliente\",\n  \"apellidos\": \"Prueba S14\",\n  \"email\": \"{{demoEmail}}\",\n  \"telefono\": \"999999999\",\n  \"direccion\": \"Datos ficticios de desarrollo\",\n  \"estado\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/clientes" }
        }
      ]
    },
    {
      "name": "Ventas",
      "item": [
        {
          "name": "Buscar ventas paginadas · 200",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{vendedorToken}}" }], "url": "{{baseUrl}}/ventas/buscar?pagina=0&tamanio=10&ordenarPor=fecha&direccion=desc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Consulta paginada responde 200', () => pm.response.to.have.status(200));", "pm.test('Incluye metadatos de paginación', () => pm.expect(pm.response.json()).to.have.property('totalElementos'));"] } }]
        },
        {
          "name": "Venta sin detalles · 400",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{vendedorToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{demoClienteId}},\n  \"detalles\": []\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/ventas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Venta sin líneas responde 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Registrar venta temporal · 201 (descuenta una unidad)",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{vendedorToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{demoClienteId}},\n  \"detalles\": [{ \"productoId\": {{demoProductoId}}, \"cantidad\": 1 }]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/ventas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registro de venta responde 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('demoVentaId', pm.response.json().id);"] } }]
        },
        {
          "name": "Venta con stock excedido · 409",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{vendedorToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"clienteId\": {{demoClienteId}},\n  \"detalles\": [{ \"productoId\": {{demoProductoId}}, \"cantidad\": 999999 }]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/ventas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Stock insuficiente responde 409', () => pm.response.to.have.status(409));"] } }]
        }
      ]
    },
    {
      "name": "Auditoría · acceso por permiso",
      "item": [
        {
          "name": "Sin token · 401",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auditoria?pagina=0&tamanio=20" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Auditoría sin token responde 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Vendedor · 403",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{vendedorToken}}" }], "url": "{{baseUrl}}/auditoria?pagina=0&tamanio=20" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Vendedor no accede a auditoría (403)', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Admin · 200 con filtros de fecha y acción",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/auditoria?pagina=0&tamanio=20&accion=VENTA_REGISTRADA" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin consulta auditoría (200)', () => pm.response.to.have.status(200));", "pm.test('Auditoría responde contenido paginado', () => pm.expect(pm.response.json()).to.have.property('contenido'));"] } }]
        }
      ]
    }
  ]
}
